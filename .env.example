# Never commit real values. Copy to .env.local for local development.
# Supabase Dashboard -> Connect -> Transaction pooler (port 6543).
# Copy the exact host/username from the dashboard; percent-encode password symbols.
DATABASE_URL=
# Supabase Direct connection OR Session pooler (port 5432); schema commands only.
# This is needed on your PC for npm run db:migrate; not needed by Vercel at runtime.
DIRECT_URL=
# Optional: Supabase root CA PEM if the connection requires a custom certificate.
# Paste PEM on one line with literal \n separators. TLS verification stays enabled.
DATABASE_CA_CERT=
# At least 16 characters; this is the password for /admin/ (no username).
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Generate another random secret for Vercel's daily price-history snapshot.
CRON_SECRET=
# Set this to your final production HTTPS domain, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.egyptgold.online
GOOGLE_SITE_VERIFICATION=
# Optional: only enable after configuring your own AdSense account and ad units.
NEXT_PUBLIC_ADSENSE_PUB_ID=
# Estimate multiplier over the spot-derived gram value, disclosed on /methodology/.
MARKET_MARKUP=1.015
